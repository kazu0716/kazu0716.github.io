---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="404 — Kazuki Odo"
  description="The page you’re looking for doesn’t exist."
>
  <main
    class="relative z-10 mx-auto flex min-h-[80vh] max-w-[960px] flex-col items-start justify-center gap-5 px-[clamp(20px,4vw,40px)]"
  >
    <p class="font-mono text-[0.95rem] text-cream-3">
      <span class="mr-1.5 text-green">$</span>
      cat /var/log/404.log
    </p>

    <h1 class="text-[clamp(3rem,10vw,6rem)] font-bold leading-none tracking-tight text-cream">
      404
    </h1>

    <p class="max-w-[60ch] text-cream-2">
      The page you’re looking for doesn’t exist — or has moved. Try heading
      back to the home page.
    </p>

    <a
      href="/"
      class="inline-flex items-center gap-1.5 rounded-lg border border-blue bg-blue px-4 py-2.5 font-mono text-[0.9rem] font-medium text-ink transition hover:-translate-y-px hover:brightness-110"
    >
      <span aria-hidden="true">←</span> Back to home
    </a>
  </main>
</Layout>
